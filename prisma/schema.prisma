// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  name          String?
  myshopifyDomain String   @unique
  email         String?
  currencyCode  String?
  timezone      String?
  planName      String?
  primaryLocale String?
  settings      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products              Product[]
  variants              ProductVariant[]
  locations             Location[]
  inventoryLevels       InventoryLevel[]
  syncTracking          SyncTracking[]
  webhookEvents         WebhookEvent[]
  suppliers             Supplier[]
  supplierProducts      SupplierProduct[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderItems    PurchaseOrderItem[]

  @@index([domain])
  @@index([myshopifyDomain])
}

model Product {
  id            String    @id @default(cuid())
  shopId        String
  shopifyId     String
  title         String
  handle        String?
  vendor        String?
  productType   String?
  status        String?
  tags          String[]
  publishedAt   DateTime?
  templateSuffix String?
  bodyHtml      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants      ProductVariant[]
  supplierProducts SupplierProduct[]

  @@unique([shopId, shopifyId])
  @@index([shopId, handle])
  @@index([shopId, status])
  @@index([shopId, vendor])
}

model ProductVariant {
  id            String    @id @default(cuid())
  shopId        String
  productId     String
  shopifyId     String
  title         String
  sku           String?
  barcode       String?
  price         Decimal   @db.Decimal(19, 4)
  compareAtPrice Decimal?  @db.Decimal(19, 4)
  inventoryItemId String?
  inventoryPolicy String?
  position      Int?
  weight        Decimal?  @db.Decimal(19, 4)
  weightUnit    String?
  taxable       Boolean?
  requiresShipping Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels   InventoryLevel[]
  supplierProducts  SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([shopId, shopifyId])
  @@unique([shopId, productId, shopifyId])
  @@index([shopId, inventoryItemId])
  @@index([shopId, sku])
}

model Location {
  id            String    @id @default(cuid())
  shopId        String
  shopifyId     String
  name          String
  address1      String?
  address2      String?
  city          String?
  province      String?
  provinceCode  String?
  country       String?
  countryCode   String?
  zip           String?
  phone         String?
  isActive      Boolean   @default(true)
  legacy        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]

  @@unique([shopId, shopifyId])
  @@index([shopId, isActive])
}

model InventoryLevel {
  id                String    @id @default(cuid())
  shopId            String
  inventoryItemId   String
  locationId        String
  variantId         String?
  available         Int       @default(0)
  updatedAt         DateTime  @updatedAt
  shopifyUpdatedAt  DateTime?
  lastSyncedAt      DateTime  @default(now())

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([shopId, inventoryItemId, locationId])
  @@index([shopId, variantId])
  @@index([shopId, locationId])
  @@index([shopId, updatedAt])
}

model SyncTracking {
  id            String    @id @default(cuid())
  shopId        String
  syncType      String
  status        String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  errorSummary  String?
  recordsProcessed Int    @default(0)
  recordsCreated   Int    @default(0)
  recordsUpdated   Int    @default(0)
  recordsFailed    Int    @default(0)
  cursor         String?
  hasNextPage    Boolean  @default(false)

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, syncType, status])
  @@index([shopId, startedAt])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  shopId        String
  shopifyEventId String   @unique
  topic         String
  status        String    @default("received")
  payload       Json?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  error         String?
  retryCount    Int       @default(0)

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, topic, status])
  @@index([shopId, receivedAt])
  @@index([shopId, shopifyEventId])
}

model Supplier {
  id              String    @id @default(cuid())
  shopId          String
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  province        String?
  country         String?
  postalCode      String?
  defaultLeadTime Int       @default(14)
  minOrderValue   Decimal?  @db.Decimal(19, 4)
  minOrderQty     Int?
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierProducts   SupplierProduct[]
  purchaseOrders     PurchaseOrder[]

  @@unique([shopId, name])
  @@index([shopId, isActive])
}

model SupplierProduct {
  id              String    @id @default(cuid())
  shopId          String
  supplierId      String
  productId       String
  productVariantId String
  supplierSku     String?
  unitCost        Decimal?  @db.Decimal(19, 4)
  currency        String?   @default("USD")
  leadTimeDays    Int?
  minOrderQty     Int?
  isPreferred     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant  ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([shopId, supplierId, productVariantId])
  @@index([shopId, supplierId])
  @@index([shopId, productVariantId])
  @@index([shopId, productId])
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  shopId            String
  supplierId        String
  poNumber          String
  status            String    @default("draft")
  expectedDate      DateTime?
  submittedAt       DateTime?
  receivedAt        DateTime?
  cancelledAt       DateTime?
  currency          String    @default("USD")
  subtotal          Decimal   @default(0) @db.Decimal(19, 4)
  taxTotal          Decimal   @default(0) @db.Decimal(19, 4)
  total             Decimal   @default(0) @db.Decimal(19, 4)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier          Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items             PurchaseOrderItem[]

  @@unique([shopId, poNumber])
  @@index([shopId, status])
  @@index([shopId, supplierId])
  @@index([shopId, createdAt])
}

model PurchaseOrderItem {
  id                  String    @id @default(cuid())
  shopId              String
  purchaseOrderId     String
  supplierProductId   String?
  productVariantId    String
  supplierSkuSnapshot String?
  productTitleSnapshot String
  variantTitleSnapshot String
  skuSnapshot         String?
  orderedQty          Int
  receivedQty         Int       @default(0)
  unitCost            Decimal   @db.Decimal(19, 4)
  lineTotal           Decimal   @db.Decimal(19, 4)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProduct     SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  productVariant      ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([shopId, purchaseOrderId])
  @@index([shopId, productVariantId])
  @@index([shopId, supplierProductId])
}